# =============================================================================
# Copy to .env.local for app/runtime secrets (Docker api/cron use .env.local).
# Copy Mongo passwords (+ optional CLOUD_MONGODB_URI) to project-root .env for
# Docker Compose interpolation and offline mongodump — never commit real values.
# =============================================================================

# --- Project-root .env (Compose + backup only) ---
# MONGO_ROOT_PASSWORD=
# MONGO_PASSWORD=
# Host publish port for the API container (container listens on 3012 always).
# Local default 3012. VPS side-by-side with live PM2 on 3012: use 3112.
# API_HOST_PORT=3012
# Cloud source for mongodump (Atlas). Do NOT point Docker api at this URI.
# CLOUD_MONGODB_URI=<atlas-srv-uri-for-database-habit_tracker_api>

# --- .env.local (Next.js + Docker api/cron runtime) ---
# Local Docker Mongo (host tools only). Inside Compose, MONGODB_URI is overridden.
MONGODB_URI=mongodb://appuser:CHANGE_ME@127.0.0.1:27017/habit_tracker?authSource=habit_tracker

# Firebase Admin (FCM send only — mobile app does not use Firebase Auth)
# Split projects (recommended when Android and iOS use different Firebase consoles):
FIREBASE_ANDROID_PROJECT_ID=
FIREBASE_ANDROID_CLIENT_EMAIL=
FIREBASE_ANDROID_PRIVATE_KEY=
FIREBASE_IOS_PROJECT_ID=
FIREBASE_IOS_CLIENT_EMAIL=
FIREBASE_IOS_PRIVATE_KEY=
# Legacy single project (optional fallback if a platform-specific block above is omitted)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cron (Authorization: Bearer <CRON_SECRET> or x-cron-secret)
CRON_SECRET=

# Admin JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=habit-tracker-api
JWT_AUDIENCE=habit-tracker-admin
REFRESH_COOKIE_NAME=babit_refresh
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# First admin — npm run seed (dev). Keep ADMIN_SEED_ENABLED=false in production.
ADMIN_SEED_ENABLED=false
ADMIN_SEED_EMAIL=admin@habittracker.local
ADMIN_SEED_PASSWORD=admin12345
ADMIN_SEED_NAME=Admin

# App
APP_NAME=Habit Tracker
APP_VERSION=0.1.0
PORT=3012
API_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3000
# Fallback when a device/reminder has no IANA timezone (legacy rows).
REMINDER_TIMEZONE=Asia/Karachi
# Mobile abuse protection (in-memory per server process; default on)
MOBILE_RATE_LIMIT_ENABLED=true
MOBILE_RATE_LIMIT_WINDOW_MS=60000
MOBILE_RATE_LIMIT_DEVICES_PER_MIN=30
MOBILE_RATE_LIMIT_REMINDERS_PER_MIN=120
# PM2 / host cron → Next on loopback. Docker Compose overrides this to http://api:3012
CRON_INTERNAL_URL=http://127.0.0.1:3012
