# MongoDB
MONGODB_URI=mongodb://localhost:27017/habit-tracker

# Firebase Admin (FCM + mobile ID tokens)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cron (Authorization: Bearer <CRON_SECRET> or x-cron-secret)
CRON_SECRET=

# Admin JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=habit-tracker-api
JWT_AUDIENCE=habit-tracker-admin
REFRESH_COOKIE_NAME=babit_refresh
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# First admin — npm run seed (dev). Keep ADMIN_SEED_ENABLED=false in production.
ADMIN_SEED_ENABLED=false
ADMIN_SEED_EMAIL=admin@habittracker.local
ADMIN_SEED_PASSWORD=admin12345
ADMIN_SEED_NAME=Admin

# App
APP_NAME=Habit Tracker
APP_VERSION=0.1.0
PORT=3000
API_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3000
REMINDER_TIMEZONE=Asia/Karachi
# Contabo cron worker talks to Next on loopback
CRON_INTERNAL_URL=http://127.0.0.1:3000
